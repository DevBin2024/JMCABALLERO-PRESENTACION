<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#075c43">
  <meta name="description" content="José Manuel Caballero Valenzuela, Gerente de Fitonova SpA. I+D+i, sanidad vegetal y soluciones para una agricultura sustentable. Guarda su contacto o comunícate directamente.">
  <title>José Manuel Caballero · Fitonova SpA</title>
  <style>
    :root {
      color-scheme:light;
      --forest:#063f35;
      --green:#075c43;
      --leaf:#598e24;
      --ink:#093f36;
      --muted:#456454;
      --paper:#fcfdf9;
      --line:#d3dfd1;
    }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:radial-gradient(ellipse at 90% 0%,#e3edc9 0,transparent 43%),#edf2e9; font-family:"Segoe UI",Inter,Arial,sans-serif; -webkit-font-smoothing:antialiased; }
    a { color:inherit; text-decoration:none; }
    button,textarea { font:inherit; }
    button { cursor:pointer; }
    a,button { -webkit-tap-highlight-color:transparent; }
    a:focus-visible,button:focus-visible,textarea:focus-visible { outline:3px solid #4b7820; outline-offset:5px; }
    .icon { display:block; width:26px; height:26px; fill:none; stroke:currentColor; stroke-width:1.65; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
    .symbols { position:absolute; width:0; height:0; overflow:hidden; }
    .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    .fitonova-card { position:relative; isolation:isolate; width:min(1080px,calc(100% - 64px)); margin:32px auto; overflow:hidden; border:1px solid #fff; border-radius:28px; background:radial-gradient(ellipse at 98% 10%,#eff3d6b3 0,transparent 43%),linear-gradient(125deg,#fff 0%,#fcfdf9 63%,#f3f6e6 100%); box-shadow:0 18px 70px #193d2412; }
    .card-body { position:relative; z-index:1; padding:48px 56px 38px; }
    .botanical-art { position:absolute; z-index:-1; width:35%; height:470px; right:-3%; top:200px; opacity:.85; pointer-events:none; mask-image:linear-gradient(90deg,transparent 0%,#000 34%,#000 100%); -webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 34%,#000 100%); }
    .botanical-art svg { display:block; width:100%; height:100%; overflow:hidden; }
    .topline { display:flex; align-items:flex-start; justify-content:space-between; gap:32px; }
    .portrait-frame { flex:0 0 auto; width:224px; height:224px; margin:0; padding:4px; border:2px solid #498528; border-radius:50%; background:#fff; box-shadow:0 6px 25px #2953310d; }
    .portrait { display:block; width:100%; height:100%; object-fit:cover; object-position:50% 43%; border-radius:50%; }
    .brand { display:block; width:430px; max-width:53%; margin-top:-12px; border-radius:8px; }
    .brand-art { display:block; width:100%; height:auto; overflow:hidden; mix-blend-mode:multiply; }
    .profile { margin-top:26px; position:relative; }
    .eyebrow { display:flex; align-items:center; gap:8px; margin:0 0 11px; font-size:10px; font-weight:650; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); }
    .eyebrow::before { content:""; width:6px; height:6px; background:var(--leaf); border-radius:50%; }
    h1 { max-width:90%; margin:0; font-size:clamp(36px,4.4vw,54px); font-weight:750; letter-spacing:-.045em; line-height:1.06; overflow-wrap:break-word; }
    h1 span { display:block; }
    .role { display:inline-block; margin:15px 0 0; padding-bottom:13px; border-bottom:3px solid #629f2c; font-size:29px; font-weight:400; line-height:1.1; }
    .company { margin:12px 0 0; font-size:22px; font-weight:450; }
    .intro { max-width:85%; margin:20px 0 0; font-size:17px; line-height:1.65; text-wrap:pretty; }
    .connection-grid { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1fr); align-items:start; gap:34px; margin-top:29px; }
    .contact-list { display:grid; gap:21px; padding:5px 0; margin:0; font-style:normal; }
    .contact-row { display:flex; align-items:center; gap:16px; min-width:0; min-height:56px; border-radius:12px; }
    a.contact-row:hover .contact-value { text-decoration:underline; text-underline-offset:4px; }
    .contact-icon { display:grid; place-items:center; flex-shrink:0; width:52px; height:52px; border-radius:50%; background:linear-gradient(140deg,#075b42,#007653); color:#fff; }
    .contact-icon .icon { width:28px; height:28px; }
    .contact-copy { min-width:0; }
    .contact-value { display:block; color:#163c3d; font-size:18px; font-weight:600; line-height:1.4; overflow-wrap:anywhere; }
    .contact-label { display:block; margin-top:2px; font-size:14px; font-weight:400; color:var(--muted); line-height:1.45; }
    .actions { display:grid; gap:10px; }
    .action { --start:#086846; --end:#075944; display:flex; align-items:center; gap:17px; min-width:0; min-height:56px; padding:12px 22px; border:0; border-radius:999px; color:#fff; background:linear-gradient(105deg,var(--start),var(--end)); box-shadow:0 3px 10px #083f3010; transition:transform .18s,box-shadow .18s; }
    .action:hover { transform:translateY(-2px); box-shadow:0 6px 17px #083f3023; }
    .action-label { flex:1; font-size:17px; font-weight:650; line-height:1.4; }
    .action .icon { width:27px; height:27px; }
    .action .chevron { width:18px; height:18px; margin-left:auto; }
    .action--phone { --start:#0b8058; --end:#08744a; }
    .action--email { --start:#23824f; --end:#137346; }
    .action--web { --start:#007c72; --end:#006e5c; }
    .action--save { --start:#07534b; --end:#06443f; }
    .action--share { min-height:46px; background:#ffffffb3; color:var(--green); border:1px solid #9db5a5; box-shadow:none; }
    .action--share .action-label { font-size:14px; font-weight:600; }
    .action--share .icon { width:20px; height:20px; }
    .download-hint { margin:11px 10px 0; color:var(--muted); text-align:center; font-size:11px; line-height:1.6; }
    .growing-footer { position:relative; isolation:isolate; display:grid; grid-template-columns:minmax(0,1fr) 202px; align-items:center; gap:36px; min-height:295px; padding:32px 56px 30px; color:#fff; background:#084e39; }
    .landscape-art { position:absolute; inset:0; z-index:-2; overflow:hidden; pointer-events:none; }
    .landscape-art svg { display:block; width:100%; height:100%; overflow:hidden; }
    .growing-footer::before { content:""; position:absolute; z-index:-1; inset:0; background:linear-gradient(110deg,#033c31ed 0%,#06513bd9 57%,#0e5e36a8 100%); }
    .expertise { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; max-width:610px; }
    .specialty { display:flex; flex-direction:column; align-items:center; gap:11px; padding:0 12px; min-width:0; text-align:center; }
    .specialty + .specialty { border-left:1px solid #ffffff7d; }
    .specialty .icon { width:38px; height:38px; stroke-width:1.35; }
    .specialty span { font-size:12px; line-height:1.45; }
    .motto { position:relative; width:fit-content; margin:27px auto 9px; font-family:"Segoe Print","Bradley Hand",Georgia,serif; font-size:27px; font-weight:400; font-style:italic; text-align:center; line-height:1.38; letter-spacing:-.035em; }
    .motto::after { content:""; display:block; width:73%; height:8px; margin:10px auto 0; border-top:4px solid #77b82f; border-radius:50%; transform:rotate(-5deg); }
    .qr-card { margin:0; padding:10px 10px 0; border:2px solid #dce7d2; border-radius:20px; background:#fff; box-shadow:0 7px 24px #062f2920; color:var(--forest); }
    .qr-link { display:block; border-radius:10px; }
    .growing-footer a:focus-visible { outline-color:#cae9a2; }
    .qr-image { display:block; width:100%; height:auto; aspect-ratio:1; }
    .qr-card figcaption { display:flex; align-items:center; justify-content:center; gap:7px; margin:8px -10px -2px; padding:11px 8px; background:var(--forest); border:1px solid #e5eddb; border-radius:0 0 17px 17px; color:#fff; font-size:10px; line-height:1.5; text-align:left; }
    .qr-card figcaption .icon { width:23px; height:23px; }
    .qr-card figcaption strong { display:block; font-size:11px; }
    .page-note { margin:19px 20px 28px; text-align:center; font-size:11px; line-height:1.7; color:var(--muted); }
    dialog { width:min(460px,calc(100% - 32px)); max-height:calc(100svh - 32px); overflow:auto; padding:26px; border:1px solid var(--line); border-radius:24px; color:var(--ink); background:var(--paper); box-shadow:0 25px 90px #063c3540; }
    dialog::backdrop { background:#053e32a6; }
    .dialog-head { display:flex; align-items:center; justify-content:space-between; gap:12px; }
    .dialog-head h2 { margin:0; font-size:23px; font-weight:650; letter-spacing:-.025em; }
    .close { display:grid; place-items:center; flex-shrink:0; width:44px; height:44px; border:0; border-radius:50%; background:#eaf0e4; color:var(--green); }
    .close .icon { width:21px; height:21px; }
    .dialog-text { margin:15px 0; color:var(--muted); font-size:14px; line-height:1.65; }
    .share-label { display:block; margin-bottom:8px; font-size:12px; font-weight:600; color:var(--muted); }
    .share-text { display:block; width:100%; min-height:125px; padding:13px; border:1px solid #bccfbd; border-radius:12px; background:#fff; color:var(--ink); font-size:13px; line-height:1.7; resize:vertical; overflow-wrap:anywhere; }
    .copy { width:100%; min-height:46px; margin-top:12px; border:0; border-radius:999px; background:var(--green); color:#fff; font-size:14px; font-weight:600; }
    .share-options { display:flex; flex-wrap:wrap; gap:10px; margin-top:14px; }
    .share-options a { display:flex; align-items:center; min-height:44px; padding:10px 16px; border:1px solid #b5cbb9; border-radius:999px; font-size:13px; }
    .toast { position:fixed; z-index:3; bottom:22px; left:50%; transform:translateX(-50%); width:max-content; max-width:calc(100% - 32px); padding:14px 20px; border:1px solid #ffffff29; border-radius:14px; background:var(--forest); color:#fff; box-shadow:0 5px 28px #073d322b; font-size:13px; line-height:1.6; }
    .toast:empty { display:none; }
    @media(min-width:1400px) { .fitonova-card { margin:40px auto; } }
    @media(min-width:701px) and (max-width:1000px) {
      .fitonova-card { width:calc(100% - 40px); margin:20px auto; }
      .card-body { padding:36px 34px 30px; }
      .portrait-frame { width:195px; height:195px; }
      .brand { width:370px; max-width:55%; margin-top:-8px; }
      h1 { font-size:43px; }
      .intro { max-width:88%; font-size:16px; }
      .connection-grid { gap:22px; grid-template-columns:minmax(0,1.08fr) minmax(0,1fr); }
      .contact-row { gap:11px; }
      .contact-icon { width:44px; height:44px; }
      .contact-value { font-size:16px; }
      .contact-label { font-size:13px; }
      .action { padding:12px 18px; gap:12px; }
      .action-label { font-size:16px; }
      .growing-footer { padding:30px 34px; gap:25px; grid-template-columns:minmax(0,1fr) 175px; }
      .specialty { padding:0 8px; }
      .specialty span { font-size:11px; }
      .motto { font-size:24px; }
    }
    @media(max-width:700px) {
      body { background:var(--paper); }
      .fitonova-card { width:100%; margin:0; border:0; border-radius:0; box-shadow:none; }
      .card-body { padding:27px 24px 29px; }
      .topline { align-items:center; gap:12px; }
      .portrait-frame { width:clamp(105px,30vw,158px); height:auto; aspect-ratio:1; padding:3px; }
      .brand { width:54%; max-width:280px; margin:-9px 0 0; }
      .profile { margin-top:25px; }
      .eyebrow { font-size:8px; letter-spacing:.1em; margin-bottom:12px; }
      h1 { max-width:100%; font-size:clamp(33px,8.4vw,48px); line-height:1.08; }
      .role { margin-top:14px; padding-bottom:10px; border-width:2px; font-size:25px; }
      .company { margin-top:10px; font-size:20px; }
      .intro { max-width:100%; margin-top:18px; font-size:15px; line-height:1.7; }
      .desktop-break { display:none; }
      .botanical-art { width:52%; height:330px; right:-13%; top:202px; opacity:.25; mask-image:linear-gradient(90deg,transparent,#000); -webkit-mask-image:linear-gradient(90deg,transparent,#000); }
      .connection-grid { grid-template-columns:1fr; gap:25px; margin-top:25px; }
      .contact-list { gap:17px; padding:0; }
      .contact-row { min-height:48px; gap:13px; }
      .contact-icon { width:46px; height:46px; }
      .contact-icon .icon { width:25px; height:25px; }
      .contact-value { font-size:17px; }
      .contact-label { font-size:13px; }
      .actions { gap:10px; }
      .action { min-height:54px; padding:12px 22px; }
      .action-label { font-size:16px; }
      .action--share { min-height:47px; }
      .download-hint { margin-top:12px; font-size:10px; }
      .growing-footer { grid-template-columns:1fr; gap:25px; padding:30px 24px; }
      .expertise { max-width:480px; margin:auto; }
      .specialty { padding:0 8px; gap:10px; }
      .specialty .icon { width:32px; height:32px; }
      .specialty span { font-size:10px; }
      .motto { margin-top:25px; font-size:26px; }
      .qr-card { width:190px; justify-self:center; }
      .page-note { font-size:10px; margin:16px 20px 22px; }
    }
    @media(max-width:360px) {
      .card-body { padding:24px 19px 26px; }
      .portrait-frame { width:99px; }
      .brand { width:55%; }
      h1 { font-size:31px; }
      .contact-value { font-size:15px; }
      .contact-row { gap:11px; }
      .growing-footer { padding:28px 19px; }
      .specialty { padding:0 5px; }
      .specialty span { font-size:9px; }
      .specialty .icon { width:28px; height:28px; }
      .motto { font-size:23px; }
    }
    @media(prefers-reduced-motion:reduce) { *,*::before,*::after { transition:none!important; } }
    @media print {
      body { background:#fff; }
      .fitonova-card { width:100%; margin:0; border:0; border-radius:0; box-shadow:none; }
      .card-body { padding:20px; }
      .portrait-frame { width:120px; height:120px; }
      .brand { width:280px; }
      .botanical-art,.actions-column,.page-note,dialog,.toast { display:none!important; }
      h1 { font-size:32px; }
      .connection-grid { display:block; }
      .contact-list { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
      .contact-row { break-inside:avoid; }
      .contact-icon { background:#fff; color:var(--green); border:1px solid var(--line); }
      .contact-value { font-size:13px; }
      .contact-label { font-size:11px; }
      .growing-footer { grid-template-columns:1fr 150px; padding:20px; break-inside:avoid; }
      .growing-footer,.contact-icon,.qr-card figcaption { print-color-adjust:exact; -webkit-print-color-adjust:exact; }
      .specialty { padding:0 8px; }
      .specialty span { font-size:10px; }
      .motto { font-size:22px; }
    }
  </style>
</head>
<body>
  <svg class="symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
    <symbol id="phone" viewBox="0 0 24 24"><path d="m7 3-4 2c-1 7 8 16 15 16l3-4-5-4-3 3-5-5 3-3-4-5Z"/></symbol>
    <symbol id="mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></symbol>
    <symbol id="globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18M5 6.5h14M5 17.5h14"/></symbol>
    <symbol id="pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
    <symbol id="whatsapp" viewBox="0 0 24 24"><path d="m4 17-1 4 4-1a9 9 0 1 0-3-3Z"/><path d="m8 7-1 2c1 4 4 7 8 7l2-2-3-2-1 1-3-3 1-1-3-2Z"/></symbol>
    <symbol id="chevron" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></symbol>
    <symbol id="contact" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M2 21v-3a7 7 0 0 1 14 0v3M19 9v8m-4-4h8"/></symbol>
    <symbol id="share" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m9 10 6-4m-6 8 6 4"/></symbol>
    <symbol id="close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol>
    <symbol id="mobile" viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 18h4"/></symbol>
    <symbol id="leaf" viewBox="0 0 32 32"><path d="M27 4C12 4 4 10 6 21c12 5 22-3 21-17ZM3 29 22 11"/></symbol>
    <symbol id="flask" viewBox="0 0 32 32"><path d="M12 3h8m-6 0v10L5 27c-1 2 0 2 2 2h18c2 0 3 0 2-2l-9-14V3M10 20h12"/><circle cx="14" cy="24" r="1"/><circle cx="20" cy="25" r=".8"/></symbol>
    <symbol id="sprout" viewBox="0 0 32 32"><path d="M16 29V13m0 11C7 24 4 19 4 14c8 0 12 5 12 10Zm0-7c8 0 12-5 12-10-8 0-12 5-12 10Zm0-4c-5-4-5-8 0-12 5 4 5 8 0 12Z"/></symbol>
    <symbol id="tree" viewBox="0 0 32 32"><path d="M13 29h6l-1-11m-4 11 1-11M9 20c-7 0-8-8-3-11-2-5 4-9 8-5 3-6 11-3 10 2 7 1 8 8 3 11 1 6-7 8-11 4-2 3-7 2-7-1ZM16 21V9m0 7-4-3m4 1 4-4"/></symbol>
  </defs></svg>

  <main class="fitonova-card" aria-labelledby="name">
    <div class="card-body">
      <!-- Composición nativa de la imagen aprobada: conserva su logo y sus motivos vegetales. -->
      <div class="botanical-art" aria-hidden="true"><svg viewBox="758 312 266 326" preserveAspectRatio="xMaxYMid slice" focusable="false"><image href="./Tarjeta%20de%20contacto%20Fitonova%20sustentable.png" width="1024" height="1536"/></svg></div>
      <header>
        <div class="topline">
          <figure class="portrait-frame"><img class="portrait" src="./jmcaballero.jpeg" alt="José Manuel Caballero Valenzuela" width="1176" height="1600"></figure>
          <a class="brand" href="https://www.fitonova.org/" target="_blank" rel="noopener noreferrer" aria-label="Fitonova SpA, innovación para la sanidad vegetal. Visitar sitio web.">
            <svg class="brand-art" viewBox="495 30 475 278" role="img" aria-label="Fitonova SpA · Innovación para la sanidad vegetal"><image href="./Tarjeta%20de%20contacto%20Fitonova%20sustentable.png" width="1024" height="1536"/></svg>
          </a>
        </div>
        <div class="profile">
          <p class="eyebrow">Tarjeta de presentación digital</p>
          <h1 id="name"><span>José Manuel</span>Caballero Valenzuela</h1>
          <p class="role">Gerente</p>
          <p class="company">Fitonova SpA</p>
          <p class="intro">I+D+i en sanidad vegetal, desarrollo de biopesticidas<br class="desktop-break"> y soluciones tecnológicas para una agricultura sustentable.</p>
        </div>
      </header>

      <div class="connection-grid">
        <section aria-labelledby="contactTitle">
          <h2 id="contactTitle" class="sr-only">Datos de contacto</h2>
          <address class="contact-list">
            <a class="contact-row" href="tel:+56939114532"><span class="contact-icon"><svg class="icon" aria-hidden="true"><use href="#phone"/></svg></span><span class="contact-copy"><span class="contact-value">+56 9 3911 4532</span><span class="contact-label">Llamar / WhatsApp</span></span></a>
            <a class="contact-row" href="mailto:jcaballero@fitonova.cl"><span class="contact-icon"><svg class="icon" aria-hidden="true"><use href="#mail"/></svg></span><span class="contact-copy"><span class="contact-value">jcaballero@fitonova.cl</span><span class="contact-label">Correo electrónico</span></span></a>
            <a class="contact-row" href="https://www.fitonova.org/" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><svg class="icon" aria-hidden="true"><use href="#globe"/></svg></span><span class="contact-copy"><span class="contact-value">www.fitonova.org</span><span class="contact-label">Sitio web</span></span></a>
            <div class="contact-row"><span class="contact-icon"><svg class="icon" aria-hidden="true"><use href="#pin"/></svg></span><span class="contact-copy"><span class="contact-value">Región del Maule, Chile</span><span class="contact-label">Ubicación</span></span></div>
          </address>
        </section>
        <div class="actions-column">
          <nav class="actions" aria-label="Contactar y guardar los datos de José Manuel">
            <a class="action" href="https://wa.me/56939114532" target="_blank" rel="noopener noreferrer"><svg class="icon" aria-hidden="true"><use href="#whatsapp"/></svg><span class="action-label">WhatsApp</span><svg class="icon chevron" aria-hidden="true"><use href="#chevron"/></svg></a>
            <a class="action action--phone" href="tel:+56939114532"><svg class="icon" aria-hidden="true"><use href="#phone"/></svg><span class="action-label">Llamar</span><svg class="icon chevron" aria-hidden="true"><use href="#chevron"/></svg></a>
            <a class="action action--email" href="mailto:jcaballero@fitonova.cl"><svg class="icon" aria-hidden="true"><use href="#mail"/></svg><span class="action-label">Correo</span><svg class="icon chevron" aria-hidden="true"><use href="#chevron"/></svg></a>
            <a class="action action--web" href="https://www.fitonova.org/" target="_blank" rel="noopener noreferrer"><svg class="icon" aria-hidden="true"><use href="#globe"/></svg><span class="action-label">Sitio web</span><svg class="icon chevron" aria-hidden="true"><use href="#chevron"/></svg></a>
            <a class="action action--save" href="./jose-manuel-caballero.vcf" download="Jose-Manuel-Caballero-Valenzuela.vcf"><svg class="icon" aria-hidden="true"><use href="#contact"/></svg><span class="action-label">Guardar contacto</span><svg class="icon chevron" aria-hidden="true"><use href="#chevron"/></svg></a>
            <button class="action action--share" id="shareButton" type="button"><svg class="icon" aria-hidden="true"><use href="#share"/></svg><span class="action-label">Compartir esta tarjeta</span><svg class="icon chevron" aria-hidden="true"><use href="#chevron"/></svg></button>
          </nav>
          <p class="download-hint">Al guardar, confirma la importación del contacto en tu agenda.</p>
        </div>
      </div>
    </div>

    <footer class="growing-footer">
      <div class="landscape-art" aria-hidden="true"><svg viewBox="0 1148 600 72" preserveAspectRatio="none" focusable="false"><image href="./Tarjeta%20de%20contacto%20Fitonova%20sustentable.png" width="1024" height="1536"/></svg></div>
      <div>
        <div class="expertise" role="list" aria-label="Áreas de trabajo de Fitonova">
          <div class="specialty" role="listitem"><svg class="icon" aria-hidden="true"><use href="#leaf"/></svg><span>I+D+i</span></div>
          <div class="specialty" role="listitem"><svg class="icon" aria-hidden="true"><use href="#flask"/></svg><span>Biopesticidas</span></div>
          <div class="specialty" role="listitem"><svg class="icon" aria-hidden="true"><use href="#sprout"/></svg><span>Sanidad vegetal</span></div>
          <div class="specialty" role="listitem"><svg class="icon" aria-hidden="true"><use href="#tree"/></svg><span>Agricultura<br>sustentable</span></div>
        </div>
        <p class="motto">Juntos por una agricultura<br>más sustentable.</p>
      </div>
      <figure class="qr-card">
        <a class="qr-link" href="./jose-manuel-caballero.vcf" download="Jose-Manuel-Caballero-Valenzuela.vcf" aria-label="Guardar el contacto de José Manuel Caballero"><img class="qr-image" src="./fitonova-contacto-qr.svg" alt="Código QR con los datos de contacto de José Manuel Caballero Valenzuela, Gerente de Fitonova SpA" width="300" height="300" loading="lazy"></a>
        <figcaption><svg class="icon" aria-hidden="true"><use href="#mobile"/></svg><span><strong>Escanea o toca el código</strong>y guarda mis datos</span></figcaption>
      </figure>
    </footer>
  </main>
  <p class="page-note">José Manuel Caballero Valenzuela · Fitonova SpA · Región del Maule, Chile</p>

  <dialog id="shareDialog" aria-labelledby="shareTitle" aria-describedby="shareDescription">
    <div class="dialog-head"><h2 id="shareTitle">Compartir contacto</h2><button class="close" id="closeDialog" type="button" aria-label="Cerrar"><svg class="icon" aria-hidden="true"><use href="#close"/></svg></button></div>
    <p class="dialog-text" id="shareDescription">Comparte mis datos de contacto.</p>
    <label class="share-label" id="shareLabel" for="shareText">Datos de contacto</label>
    <textarea class="share-text" id="shareText" readonly rows="6"></textarea>
    <button class="copy" id="copyButton" type="button">Copiar</button>
    <div class="share-options"><a id="shareWhatsapp" target="_blank" rel="noopener noreferrer">WhatsApp</a><a id="shareEmail">Correo electrónico</a></div>
  </dialog>
  <div class="toast" id="status" role="status" aria-live="polite"></div>
  <script>
    'use strict';
    // El archivo local comparte datos; al publicarse, comparte la URL de la tarjeta.
    const publicUrl = /^https?:$/.test(location.protocol) ? location.href.split('#')[0] : '';
    const title = 'José Manuel Caballero Valenzuela · Fitonova SpA';
    const contactText = title + '\nGerente\n+56 9 3911 4532\njcaballero@fitonova.cl\nhttps://www.fitonova.org/\nRegión del Maule, Chile';
    const shareText = publicUrl ? title + '\n' + publicUrl : contactText;
    const dialog = document.getElementById('shareDialog');
    const field = document.getElementById('shareText');
    const shareButton = document.getElementById('shareButton');
    let statusTimer;
    function notify(message) {
      clearTimeout(statusTimer);
      document.getElementById('status').textContent = message;
      statusTimer = setTimeout(() => { document.getElementById('status').textContent = ''; }, 5500);
    }
    field.value = publicUrl || contactText;
    document.getElementById('shareDescription').textContent = publicUrl ? 'Envía el enlace de esta tarjeta o cópialo para compartirlo.' : 'Comparte mis datos por WhatsApp o correo, o cópialos desde aquí.';
    document.getElementById('shareLabel').textContent = publicUrl ? 'Enlace de la tarjeta' : 'Datos de contacto';
    document.getElementById('shareWhatsapp').href = 'https://wa.me/?text=' + encodeURIComponent(shareText);
    document.getElementById('shareEmail').href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(shareText);
    shareButton.addEventListener('click', async () => {
      if (navigator.share && window.isSecureContext) {
        try {
          await navigator.share(publicUrl ? { title, text:'Gerente · Fitonova SpA', url:publicUrl } : { title, text:contactText });
          return;
        } catch (error) {
          if (error.name === 'AbortError') return;
        }
      }
      dialog.showModal();
    });
    document.getElementById('closeDialog').addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => shareButton.focus());
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
    document.getElementById('copyButton').addEventListener('click', async () => {
      try {
        if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(field.value);
        notify(publicUrl ? 'Enlace copiado.' : 'Datos de contacto copiados.');
      } catch (error) {
        field.focus();
        field.select();
        notify('Selecciona el texto y cópialo con Ctrl+C o con el menú de tu teléfono.');
      }
    });
  </script>
</body>
</html>

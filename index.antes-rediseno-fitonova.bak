<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#084e45">
  <meta name="description" content="José Manuel Caballero Valenzuela, Gerente de Fitonova SpA. Contacto e innovación para la sanidad vegetal.">
  <title>José Manuel Caballero · Fitonova SpA</title>
  <style>
    :root { color-scheme: light; --green:#084e45; --deep:#063c35; --sage:#dbe9b8; --paper:#f7f9f5; --ink:#173d3c; --muted:#536a67; --line:#dce5dd; --orange:#e99a71; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--paper); color:var(--ink); font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    a { color:inherit; text-decoration:none; }
    button,textarea { font:inherit; }
    button { cursor:pointer; }
    a,button { -webkit-tap-highlight-color:transparent; }
    a:focus-visible,button:focus-visible,textarea:focus-visible { outline:3px solid #b16b36; outline-offset:4px; }
    svg { width:23px; height:23px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; flex-shrink:0; }
    .symbols { display:none; }
    .shell { display:grid; grid-template-columns:44% 56%; min-height:100svh; }
    .story { position:relative; isolation:isolate; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; padding:clamp(30px,4vw,76px); background:var(--green); color:#fff; }
    .story::before,.story::after { content:""; position:absolute; z-index:-1; width:620px; height:620px; border:1px solid #ffffff12; border-radius:50%; pointer-events:none; }
    .story::before { top:18%; right:-420px; }
    .story::after { top:28%; right:-330px; }
    .brand { align-self:flex-start; display:inline-flex; padding:10px 17px; background:#fff; border-radius:5px; }
    .brand img { display:block; width:220px; max-width:100%; height:74px; object-fit:contain; }
    .intro { margin:38px 0 22px; }
    .eyebrow { display:flex; align-items:center; gap:10px; color:var(--sage); font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.18em; }
    .eyebrow::before { content:""; width:26px; height:1px; background:currentColor; }
    .intro h2 { margin:23px 0; font-family:Georgia,"Times New Roman",serif; font-size:clamp(43px,4.7vw,78px); font-weight:400; line-height:1.07; letter-spacing:-.045em; }
    .intro h2 em { color:var(--sage); font-weight:400; }
    .intro p { max-width:350px; margin:0; color:#deebe4; font-size:14px; line-height:1.8; }
    .portrait-box { width:clamp(190px,18vw,265px); aspect-ratio:1; padding:7px; margin:10px 0 27px; border:1px solid #dbe9b86b; border-radius:50%; }
    .portrait { display:block; width:100%; height:100%; border-radius:50%; object-fit:cover; object-position:50% 43%; }
    .story-foot { display:flex; align-items:center; justify-content:space-between; gap:16px; padding-top:21px; border-top:1px solid #ffffff29; font-size:10px; line-height:1.6; letter-spacing:.06em; color:#deebe4; }
    .story-foot a { white-space:nowrap; }
    .content { display:flex; flex-direction:column; justify-content:center; min-width:0; padding:clamp(34px,4vw,72px) clamp(28px,5vw,96px) 24px; }
    .label { display:flex; align-items:center; gap:9px; color:var(--muted); font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.16em; }
    .label::before { content:""; width:6px; height:6px; border-radius:50%; background:#a3673c; }
    h1 { margin:19px 0 12px; font-size:clamp(34px,3.15vw,58px); line-height:1.12; letter-spacing:-.045em; font-weight:650; overflow-wrap:break-word; }
    h1 span { display:block; }
    .role { margin:0; color:var(--green); font-size:19px; line-height:1.5; }
    .company { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-top:13px; color:var(--muted); font-size:12px; line-height:1.6; }
    .company strong { color:var(--ink); font-weight:600; }
    .company .separator { width:3px; height:3px; background:#81988b; border-radius:50%; }
    .lead { margin:23px 0; color:var(--muted); font-size:14px; line-height:1.75; }
    .save { display:flex; align-items:center; justify-content:space-between; gap:13px; min-height:58px; padding:17px 20px; background:var(--green); color:#fff; border-radius:10px; transition:background .2s,transform .2s; }
    .save:hover { background:var(--deep); transform:translateY(-2px); }
    .save span { flex:1; font-size:14px; font-weight:650; }
    .hint { margin:10px 0 27px; color:var(--muted); font-size:11px; line-height:1.6; text-align:center; }
    .divider { display:flex; align-items:center; gap:12px; margin-bottom:14px; color:var(--muted); font-size:10px; font-weight:700; letter-spacing:.15em; text-transform:uppercase; }
    .divider::after { content:""; flex:1; height:1px; background:var(--line); }
    .links { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:11px; }
    .link { display:flex; align-items:center; gap:12px; min-width:0; min-height:80px; padding:15px; border:1px solid var(--line); border-radius:10px; background:#fff; transition:border-color .2s,transform .2s; }
    .link:hover { border-color:#8eab97; transform:translateY(-2px); }
    .icon-box { display:grid; place-items:center; width:37px; height:37px; flex-shrink:0; border-radius:9px; background:#edf3e8; color:var(--green); }
    .link-copy { min-width:0; }
    .link strong { display:block; font-size:13px; font-weight:650; }
    .link small { display:block; margin-top:5px; color:var(--muted); font-size:11px; line-height:1.45; overflow-wrap:anywhere; }
    .arrow { width:16px; margin-left:auto; color:#667f73; }
    .location { display:flex; align-items:center; gap:9px; margin:19px 0 0; color:var(--muted); font-size:12px; line-height:1.6; }
    .location svg { width:18px; height:18px; }
    .share { display:flex; align-items:center; justify-content:center; gap:9px; align-self:center; min-height:44px; margin:16px 0; padding:10px; border:0; background:transparent; color:var(--green); font-size:12px; }
    .share svg { width:18px; height:18px; }
    .expertise { display:flex; flex-wrap:wrap; justify-content:center; gap:8px 16px; padding-top:20px; border-top:1px solid var(--line); color:var(--muted); font-size:10px; line-height:1.6; }
    .expertise span { display:flex; align-items:center; gap:6px; }
    .expertise span::before { content:""; width:4px; height:4px; border-radius:50%; background:#789858; }
    .footer { margin:14px 0 0; color:var(--muted); text-align:center; font-size:11px; line-height:1.8; }
    dialog { width:min(440px,calc(100% - 32px)); max-height:calc(100svh - 32px); overflow:auto; padding:26px; border:1px solid var(--line); border-radius:16px; background:var(--paper); color:var(--ink); box-shadow:0 20px 80px #0003; }
    dialog::backdrop { background:#063c3599; }
    .dialog-head { display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .dialog-head h2 { font-size:21px; margin:0; letter-spacing:-.025em; }
    .close { display:grid; place-items:center; flex-shrink:0; width:44px; height:44px; border:0; border-radius:50%; background:#e8efe5; color:var(--green); }
    .dialog-text { margin:15px 0; color:var(--muted); font-size:13px; line-height:1.7; }
    .share-label { display:block; margin:0 0 7px; color:var(--muted); font-size:12px; }
    .share-text { display:block; width:100%; min-height:106px; resize:vertical; padding:12px; border:1px solid var(--line); border-radius:8px; background:#fff; color:var(--ink); font-size:12px; line-height:1.6; overflow-wrap:anywhere; }
    .copy { width:100%; min-height:44px; margin-top:10px; border:0; border-radius:8px; background:var(--green); color:#fff; font-size:13px; }
    .share-options { display:flex; flex-wrap:wrap; gap:10px; margin-top:14px; }
    .share-options a { display:flex; align-items:center; min-height:44px; padding:11px 13px; border:1px solid var(--line); border-radius:8px; font-size:12px; }
    .toast { position:fixed; z-index:2; left:50%; bottom:22px; transform:translateX(-50%); width:max-content; max-width:calc(100% - 32px); padding:13px 19px; border-radius:9px; background:var(--deep); color:#fff; box-shadow:0 5px 24px #0002; font-size:12px; line-height:1.6; }
    .toast:empty { display:none; }
    @media(min-width:1100px) and (max-height:850px) {
      .story { padding-top:30px; padding-bottom:28px; }
      .brand { padding:7px 15px; }
      .brand img { width:200px; height:64px; }
      .intro { margin:26px 0 15px; }
      .intro h2 { font-size:clamp(43px,4.4vw,65px); margin:18px 0; }
      .portrait-box { width:190px; margin-bottom:22px; }
      .content { padding-top:30px; }
      h1 { font-size:clamp(34px,3vw,49px); }
      .lead { margin:17px 0; }
      .hint { margin-bottom:21px; }
      .link { min-height:74px; padding:12px; }
    }
    @media(min-width:701px) and (max-width:1099px) {
      .shell { grid-template-columns:42% 58%; }
      .story { padding:30px 25px; }
      .brand img { width:190px; height:64px; }
      .intro h2 { font-size:46px; }
      .content { padding:35px 27px 24px; }
      h1 { font-size:36px; }
      .links { grid-template-columns:1fr; }
      .link { min-height:73px; }
      .story-foot { flex-direction:column; align-items:flex-start; }
    }
    @media(max-width:700px) {
      .shell { display:block; }
      .story { display:grid; grid-template-columns:minmax(0,1fr) 104px; gap:0 12px; padding:24px 24px 30px; }
      .brand { grid-column:1/-1; justify-self:start; padding:5px 12px; }
      .brand img { width:166px; height:56px; }
      .intro { margin:25px 0 0; }
      .eyebrow { font-size:8px; letter-spacing:.12em; gap:7px; }
      .eyebrow::before { width:16px; }
      .intro h2 { font-size:clamp(30px,6vw,40px); margin:15px 0 0; line-height:1.1; }
      .intro p,.story-foot { display:none; }
      .portrait-box { align-self:center; width:104px; padding:4px; margin:24px 0 0; }
      .content { padding:31px 24px 23px; }
      .label { font-size:8px; letter-spacing:.13em; }
      h1 { margin:15px 0 9px; font-size:clamp(31px,7.6vw,43px); }
      .role { font-size:17px; }
      .company { gap:8px; font-size:11px; margin-top:8px; }
      .lead { margin:18px 0; font-size:13px; }
      .links { gap:10px; }
      .link { min-height:91px; padding:13px 11px; gap:9px; }
      .link .arrow { display:none; }
      .link strong { font-size:12px; }
      .link small { font-size:10px; }
      .icon-box { width:31px; height:34px; }
      .icon-box svg { width:20px; height:20px; }
      .hint { font-size:10px; margin-bottom:25px; }
      .expertise { gap:7px 12px; }
    }
    @media(max-width:400px) {
      .story { padding:22px 21px 27px; grid-template-columns:minmax(0,1fr) 90px; }
      .portrait-box { width:90px; }
      .intro h2 { font-size:29px; }
      .content { padding:28px 21px 22px; }
      .links { grid-template-columns:1fr; }
      .link { min-height:75px; padding:14px; }
      .link strong { font-size:13px; }
      .link small { font-size:11px; }
      .link .arrow { display:block; }
      .icon-box { width:37px; height:37px; }
    }
    @media(prefers-reduced-motion:reduce) { *,*::before,*::after { transition:none!important; } }
    @media print {
      body { background:#fff; }
      .shell { display:block; }
      .story { display:none; }
      .content { display:block; padding:16px; }
      .save,.hint,.share,dialog,.toast,.divider { display:none!important; }
      .links { grid-template-columns:1fr 1fr; margin-top:24px; }
      .link { break-inside:avoid; }
      .link:hover { transform:none; }
    }
  </style>
</head>
<body>
  <svg class="symbols" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>
    <symbol id="download" viewBox="0 0 24 24"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"/></symbol>
    <symbol id="arrow" viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12"/></symbol>
    <symbol id="mail" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 7 9 6 9-6"/></symbol>
    <symbol id="phone" viewBox="0 0 24 24"><path d="m7 3-4 2c-1 7 8 16 15 16l3-4-5-4-3 3-5-5 3-3-4-5Z"/></symbol>
    <symbol id="globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></symbol>
    <symbol id="whatsapp" viewBox="0 0 24 24"><path d="m4 17-1 4 4-1a9 9 0 1 0-3-3Z"/><path d="m8 7-1 2c1 4 4 7 8 7l2-2-3-2-1 1-3-3 1-1-3-2Z"/></symbol>
    <symbol id="pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></symbol>
    <symbol id="share" viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m9 10 6-4m-6 8 6 4"/></symbol>
    <symbol id="close" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6"/></symbol>
  </defs></svg>
  <main class="shell">
    <section class="story" aria-label="Fitonova SpA · Innovación para la sanidad vegetal">
      <a class="brand" href="https://www.fitonova.org/" target="_blank" rel="noopener noreferrer" aria-label="Visitar el sitio de Fitonova"><img src="./logo_fitonova.png" alt="Logo Fitonova" width="292" height="98"></a>
      <div class="intro">
        <div class="eyebrow">Ciencia que conecta</div>
        <h2>Innovación<br>para la<br><em>sanidad vegetal.</em></h2>
        <p>I+D+i en sanidad vegetal, desarrollo de biopesticidas y soluciones tecnológicas para una agricultura sustentable.</p>
      </div>
      <div class="portrait-box"><img class="portrait" src="./jmcaballero.jpeg" alt="José Manuel Caballero Valenzuela" width="1176" height="1600"></div>
      <div class="story-foot"><span>JUNTOS POR UNA AGRICULTURA<br>MÁS SUSTENTABLE</span><a href="https://www.fitonova.org/" target="_blank" rel="noopener noreferrer">fitonova.org ↗</a></div>
    </section>
    <section class="content" aria-labelledby="name">
      <header>
        <div class="label">Tarjeta de presentación digital</div>
        <h1 id="name"><span>José Manuel</span>Caballero Valenzuela</h1>
        <p class="role">Gerente</p>
        <div class="company"><strong>Fitonova SpA</strong><span class="separator" aria-hidden="true"></span><span>Región del Maule, Chile</span></div>
      </header>
      <p class="lead">Una conversación es el primer paso.<br>Guarda mis datos y mantengamos el contacto.</p>
      <a class="save" href="./jose-manuel-caballero.vcf" download="Jose-Manuel-Caballero-Valenzuela.vcf"><svg aria-hidden="true"><use href="#download"/></svg><span>Guardar contacto</span><svg aria-hidden="true"><use href="#arrow"/></svg></a>
      <p class="hint">Descarga el contacto y confirma su importación en tu agenda.</p>
      <div class="divider">Conversemos</div>
      <nav class="links" aria-label="Canales de contacto">
        <a class="link" href="https://wa.me/56939114532" target="_blank" rel="noopener noreferrer"><span class="icon-box"><svg aria-hidden="true"><use href="#whatsapp"/></svg></span><span class="link-copy"><strong>WhatsApp</strong><small>Hablemos directamente</small></span><svg class="arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
        <a class="link" href="tel:+56939114532"><span class="icon-box"><svg aria-hidden="true"><use href="#phone"/></svg></span><span class="link-copy"><strong>Llamar</strong><small>+56 9 3911 4532</small></span><svg class="arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
        <a class="link" href="mailto:jcaballero@fitonova.cl"><span class="icon-box"><svg aria-hidden="true"><use href="#mail"/></svg></span><span class="link-copy"><strong>Correo electrónico</strong><small>jcaballero@fitonova.cl</small></span><svg class="arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
        <a class="link" href="https://www.fitonova.org/" target="_blank" rel="noopener noreferrer"><span class="icon-box"><svg aria-hidden="true"><use href="#globe"/></svg></span><span class="link-copy"><strong>Sitio web</strong><small>www.fitonova.org</small></span><svg class="arrow" aria-hidden="true"><use href="#arrow"/></svg></a>
      </nav>
      <p class="location"><svg aria-hidden="true"><use href="#pin"/></svg>Región del Maule, Chile</p>
      <button class="share" id="shareButton" type="button"><svg aria-hidden="true"><use href="#share"/></svg>Compartir esta tarjeta</button>
      <div class="expertise" aria-label="Áreas de trabajo"><span>I+D+i</span><span>Biopesticidas</span><span>Sanidad vegetal</span><span>Agricultura sustentable</span></div>
      <footer class="footer">José Manuel Caballero Valenzuela · Fitonova SpA<br>Juntos por una agricultura más sustentable.</footer>
    </section>
  </main>
  <dialog id="shareDialog" aria-labelledby="shareTitle" aria-describedby="shareDescription">
    <div class="dialog-head"><h2 id="shareTitle">Compartir contacto</h2><button class="close" id="closeDialog" type="button" aria-label="Cerrar"><svg aria-hidden="true"><use href="#close"/></svg></button></div>
    <p class="dialog-text" id="shareDescription">Comparte mis datos de contacto.</p>
    <label class="share-label" id="shareLabel" for="shareText">Datos de contacto</label>
    <textarea class="share-text" id="shareText" readonly rows="6"></textarea>
    <button class="copy" id="copyButton" type="button">Copiar</button>
    <div class="share-options"><a id="shareWhatsapp" target="_blank" rel="noopener noreferrer">WhatsApp</a><a id="shareEmail">Correo electrónico</a></div>
  </dialog>
  <div class="toast" id="status" role="status" aria-live="polite"></div>
  <script>
    'use strict';
    // El archivo local comparte datos; una vez publicada, la tarjeta comparte su URL.
    const publicUrl = /^https?:$/.test(location.protocol) ? location.href.split('#')[0] : '';
    const title = 'José Manuel Caballero Valenzuela · Fitonova SpA';
    const contactText = title + '\nGerente\n+56 9 3911 4532\njcaballero@fitonova.cl\nhttps://www.fitonova.org/\nRegión del Maule, Chile';
    const shareText = publicUrl ? title + '\n' + publicUrl : contactText;
    const dialog = document.getElementById('shareDialog');
    const field = document.getElementById('shareText');
    const shareButton = document.getElementById('shareButton');
    let statusTimer;
    function notify(message) {
      clearTimeout(statusTimer);
      document.getElementById('status').textContent = message;
      statusTimer = setTimeout(() => { document.getElementById('status').textContent = ''; }, 5500);
    }
    field.value = publicUrl || contactText;
    document.getElementById('shareDescription').textContent = publicUrl ? 'Envía el enlace de esta tarjeta o cópialo para compartirlo.' : 'Comparte mis datos por WhatsApp o correo, o cópialos desde aquí.';
    document.getElementById('shareLabel').textContent = publicUrl ? 'Enlace de la tarjeta' : 'Datos de contacto';
    document.getElementById('shareWhatsapp').href = 'https://wa.me/?text=' + encodeURIComponent(shareText);
    document.getElementById('shareEmail').href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent(shareText);
    shareButton.addEventListener('click', async () => {
      if (navigator.share && window.isSecureContext) {
        try {
          await navigator.share(publicUrl ? { title, text:'Gerente · Fitonova SpA', url:publicUrl } : { title, text:contactText });
          return;
        } catch (error) {
          if (error.name === 'AbortError') return;
        }
      }
      dialog.showModal();
    });
    document.getElementById('closeDialog').addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => shareButton.focus());
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
    document.getElementById('copyButton').addEventListener('click', async () => {
      try {
        if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(field.value);
        notify(publicUrl ? 'Enlace copiado.' : 'Datos de contacto copiados.');
      } catch (error) {
        field.focus();
        field.select();
        notify('Selecciona el texto y cópialo con Ctrl+C o con el menú de tu teléfono.');
      }
    });
  </script>
</body>
</html>
